{
  "name": "aaagent",
  "publisher": "local",
  "displayName": "aaagent",
  "description": "Chat with Claude Opus as planner and reviewer while opencode workers (DeepSeek, GLM) implement and commit.",
  "version": "0.3.0",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aaagent",
          "title": "aaagent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "aaagent": [
        {
          "id": "aaagent.workers",
          "name": "Workers"
        },
        {
          "id": "aaagent.tasks",
          "name": "Tasks"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "aaagent.tasks",
        "contents": "No tasks yet. Start a chat and ask Opus for a change: it writes a plan, a worker implements it, Opus reviews, and a worker commits.\n[New Chat](command:aaagent.newChat)\n[Ask Opus…](command:aaagent.ask)\n[Resume Last Chat](command:aaagent.resumeChat)",
        "when": "aaagent.state == ready"
      },
      {
        "view": "aaagent.tasks",
        "contents": "This folder is not a git repository. aaagent needs git to diff and commit the workers' changes.\n[Initialize Repository](command:git.init)",
        "when": "aaagent.state == noRepo"
      },
      {
        "view": "aaagent.tasks",
        "contents": "The aaagent command was not found. Run install.sh in the aaagent folder, or set its path in the settings.\n[Open Settings](command:workbench.action.openSettings?%5B%22aaagent.path%22%5D)",
        "when": "aaagent.state == noCli"
      },
      {
        "view": "aaagent.tasks",
        "contents": "Open a folder to use aaagent.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "aaagent.state == noFolder"
      },
      {
        "view": "aaagent.tasks",
        "contents": "aaagent could not read this project's status.\n[Check Installation](command:aaagent.doctor)\n[Retry](command:aaagent.refresh)",
        "when": "aaagent.state == error"
      }
    ],
    "commands": [
      { "command": "aaagent.newChat", "title": "New Chat", "category": "aaagent", "icon": "$(add)" },
      { "command": "aaagent.openChat", "title": "Open Chat", "category": "aaagent", "icon": "$(comment-discussion)" },
      { "command": "aaagent.selectModel", "title": "Select Model…", "category": "aaagent", "icon": "$(settings)" },
      { "command": "aaagent.changeWorkerModel", "title": "Change Model…", "category": "aaagent", "icon": "$(settings)" },
      { "command": "aaagent.selectThinking", "title": "Select Thinking Level…", "category": "aaagent", "icon": "$(lightbulb)" },
      { "command": "aaagent.changeWorkerThinking", "title": "Change Thinking Level…", "category": "aaagent", "icon": "$(lightbulb)" },
      { "command": "aaagent.resumeChat", "title": "Resume Last Chat", "category": "aaagent", "icon": "$(history)" },
      { "command": "aaagent.ask", "title": "Ask Opus…", "category": "aaagent", "icon": "$(sparkle)" },
      { "command": "aaagent.sendSelection", "title": "Send Selection to Chat", "category": "aaagent" },
      { "command": "aaagent.attachImage", "title": "Attach Image…", "category": "aaagent", "icon": "$(file-media)" },
      { "command": "aaagent.attachFile", "title": "Attach to aaagent Chat", "category": "aaagent" },
      { "command": "aaagent.refresh", "title": "Refresh", "category": "aaagent", "icon": "$(refresh)" },
      { "command": "aaagent.showDiff", "title": "Show Task Changes", "category": "aaagent", "icon": "$(diff)" },
      { "command": "aaagent.openTaskFolder", "title": "Reveal Task Folder", "category": "aaagent", "icon": "$(folder-opened)" },
      { "command": "aaagent.abandonTask", "title": "Abandon Task…", "category": "aaagent", "icon": "$(trash)" },
      { "command": "aaagent.startWorkers", "title": "Start Workers", "category": "aaagent", "icon": "$(play)" },
      { "command": "aaagent.showWorker", "title": "Show Worker Output", "category": "aaagent", "icon": "$(terminal)" },
      { "command": "aaagent.stopWorker", "title": "Stop Worker", "category": "aaagent", "icon": "$(debug-stop)" },
      { "command": "aaagent.stopWorkers", "title": "Stop All Workers", "category": "aaagent", "icon": "$(debug-stop)" },
      { "command": "aaagent.doctor", "title": "Check Installation", "category": "aaagent", "icon": "$(checklist)" },
      { "command": "aaagent.openConfig", "title": "Open Configuration", "category": "aaagent", "icon": "$(gear)" }
    ],
    "menus": {
      "view/title": [
        { "command": "aaagent.newChat", "when": "view == aaagent.tasks", "group": "navigation@1" },
        { "command": "aaagent.ask", "when": "view == aaagent.tasks", "group": "navigation@2" },
        { "command": "aaagent.attachImage", "when": "view == aaagent.tasks", "group": "navigation@3" },
        { "command": "aaagent.refresh", "when": "view == aaagent.tasks", "group": "navigation@4" },
        { "command": "aaagent.openChat", "when": "view == aaagent.tasks", "group": "1_more@1" },
        { "command": "aaagent.resumeChat", "when": "view == aaagent.tasks", "group": "1_more@2" },
        { "command": "aaagent.selectModel", "when": "view == aaagent.workers", "group": "navigation@1" },
        { "command": "aaagent.selectThinking", "when": "view == aaagent.workers", "group": "navigation@2" },
        { "command": "aaagent.startWorkers", "when": "view == aaagent.workers", "group": "navigation@3" },
        { "command": "aaagent.stopWorkers", "when": "view == aaagent.workers", "group": "navigation@4" },
        { "command": "aaagent.doctor", "when": "view == aaagent.workers", "group": "1_more@1" },
        { "command": "aaagent.openConfig", "when": "view == aaagent.workers", "group": "1_more@2" }
      ],
      "view/item/context": [
        { "command": "aaagent.showDiff", "when": "view == aaagent.tasks && viewItem =~ /^task\\./", "group": "inline@1" },
        { "command": "aaagent.showDiff", "when": "view == aaagent.tasks && viewItem =~ /^task\\./", "group": "1_view@1" },
        { "command": "aaagent.openTaskFolder", "when": "view == aaagent.tasks && viewItem =~ /^task\\./", "group": "1_view@2" },
        { "command": "aaagent.abandonTask", "when": "view == aaagent.tasks && viewItem == task.active", "group": "2_manage@1" },
        { "command": "aaagent.showWorker", "when": "view == aaagent.workers && viewItem =~ /^worker\\./", "group": "inline@1" },
        { "command": "aaagent.stopWorker", "when": "view == aaagent.workers && viewItem =~ /^worker\\.(idle|running)$/", "group": "inline@2" },
        { "command": "aaagent.changeWorkerModel", "when": "view == aaagent.workers && viewItem =~ /^worker\\./", "group": "1_manage@1" },
        { "command": "aaagent.changeWorkerThinking", "when": "view == aaagent.workers && viewItem =~ /^worker\\./", "group": "1_manage@2" }
      ],
      "editor/context": [
        { "command": "aaagent.sendSelection", "when": "resourceScheme == file && aaagent.state == ready", "group": "aaagent@1" }
      ],
      "explorer/context": [
        { "command": "aaagent.attachFile", "when": "aaagent.state == ready && resourceScheme == file && resourceExtname =~ /^\\.(png|jpe?g|gif|webp)$/i", "group": "aaagent@1" }
      ],
      "editor/title/context": [
        { "command": "aaagent.attachFile", "when": "aaagent.state == ready && resourceScheme == file && resourceExtname =~ /^\\.(png|jpe?g|gif|webp)$/i", "group": "aaagent@1" }
      ],
      "commandPalette": [
        { "command": "aaagent.sendSelection", "when": "editorIsOpen && aaagent.state == ready" },
        { "command": "aaagent.attachFile", "when": "false" },
        { "command": "aaagent.changeWorkerModel", "when": "false" },
        { "command": "aaagent.changeWorkerThinking", "when": "false" }
      ]
    },
    "configuration": {
      "title": "aaagent",
      "properties": {
        "aaagent.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `aaagent` command. Empty = `~/.local/bin/aaagent`, then `PATH`."
        },
        "aaagent.chatLocation": {
          "type": "string",
          "enum": ["editor", "panel"],
          "enumDescriptions": ["Open the chat as an editor tab", "Open the chat in the terminal panel"],
          "default": "editor",
          "description": "Where the Opus chat terminal opens."
        },
        "aaagent.notifications": {
          "type": "string",
          "enum": ["all", "important", "off"],
          "enumDescriptions": [
            "Commits and problems as notifications; progress in the status bar",
            "Only commits and problems",
            "None"
          ],
          "default": "all",
          "description": "Which task events to show."
        },
        "aaagent.finishedTasksShown": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "How many committed or abandoned tasks to keep in the Tasks view."
        }
      }
    }
  }
}
